{
  "preset": "safe-reads",
  "title": "Approve safe reads",
  "readMe": "Reading and searching files and looking at git history are approved inside an approve window you open; anything that changes something asks you. The \"yours\" lists (deletes, force pushes, hard resets, skipped hooks, deploys, publishing, money, guard switches) are the same in all four presets and always wait for you: a tool name is matched whole, and a word is matched anywhere in the call, whatever its case, quotes or spacing. Never let a model edit them.",
  "judge": false,
  "routine": {
    "tools": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "ToolSearch",
      "TodoWrite"
    ],
    "commands": [
      "git status",
      "git diff",
      "git log",
      "git show",
      "git branch --show-current",
      "git rev-parse",
      "grep",
      "rg",
      "ls",
      "wc",
      "head",
      "tail",
      "cat",
      "pwd",
      "echo",
      "exit"
    ],
    "hooks": []
  },
  "yours": {
    "tools": [
      "mcp__stripe__stripe_api_write",
      "mcp__stripe__atlas_company_formation",
      "mcp__stripe__manage_stripe_accounts",
      "mcp__stripe__send_money",
      "mcp__stripe__transfer_money",
      "mcp__stripe__setup_recipient",
      "mcp__vercel__buy_domain",
      "mcp__plugin_vercel_vercel__buy_domain",
      "mcp__plugin_stripe_stripe__send_money",
      "mcp__plugin_stripe_stripe__transfer_money",
      "mcp__paypal__create_refund"
    ],
    "hooks": [
      "guard-config.js",
      "guard-skillspector.js",
      "guard-deny-catastrophic.js",
      "guard-hq-answers.js",
      "coord-guard.js",
      "coord-requests.js"
    ],
    "hookPhrases": [
      "Only the user can approve"
    ],
    "words": [
